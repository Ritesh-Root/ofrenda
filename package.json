{
  "name": "ofrenda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A digital ofrenda that answers only with what the family remembers. Local-first, Gemma via Ollama.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r --if-present build",
    "ofrenda": "pnpm --filter @ofrenda/cli run dev"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

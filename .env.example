# Ofrenda environment. Copy to .env (`cp .env.example .env`) and fill in what you need.
# Every name here comes from SPEC §4. Nothing in this file is real: no keys, no secrets.
# .env is gitignored. Local-first means you can leave every key empty and still use Ofrenda.

# 1 disables every cloud adapter: they throw OfflineError instead of calling the network.
OFRENDA_OFFLINE=0

# Where Ollama listens. This is the only model in the core.
OLLAMA_URL=http://127.0.0.1:11434

# Chat model. gemma3:1b is the fallback when free VRAM is under ~3.6 GB (4 GB GPU).
OFRENDA_MODEL=gemma3:4b

# Embedding model, 768 dimensions.
OFRENDA_EMBED_MODEL=embeddinggemma

# Postgres, from infra/compose.yaml (user, password and db are all "ofrenda" locally).
DATABASE_URL=postgres://ofrenda:ofrenda@127.0.0.1:5432/ofrenda

# Speech to text: local (whisper.cpp via nodejs-whisper) or elevenlabs (cloud, throws when offline).
OFRENDA_STT=local

# Text to speech: browser (Web Speech API), elevenlabs (cloud), or none.
OFRENDA_TTS=browser

# ElevenLabs, optional. Stock voices only: never clone the voice of someone who has died.
ELEVENLABS_API_KEY=

# Stock voice id; the default is Sarah, EXAVITQu4vr4xnSDxMaL.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# SerpApi, optional: era context for one place and one decade. Only place + decade leave the machine.
SERPAPI_API_KEY=

# Temporal frontend. If unreachable, ingest runs in-process instead.
TEMPORAL_ADDRESS=127.0.0.1:7233

# Sentry, optional. Unset means no tracing. Prompts and story text are never sent.
SENTRY_DSN=

# OpenFGA, optional. Unset means the sharing filter is off and everyone in the family sees everything.
FGA_API_URL=
# The store id OpenFGA returns when you create a store.
FGA_STORE_ID=
# The authorization model id OpenFGA returns when you write infra/openfga/model.fga.
FGA_MODEL_ID=

# Auth0, optional. Unset means the web app runs in demo mode: read-only, seeded Rosa.
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 1 = read-only public demo build (uploads disabled, extractive answer fallback). Never 1 locally.
OFRENDA_DEMO=0

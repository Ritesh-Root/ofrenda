{
  "name": "@ofrenda/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Config, offline guard, model access, DB schema and queries, hybrid search, ingest activities, grounded answer.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src --no-file-parallelism",
    "build": "tsc -p tsconfig.json --noEmit false",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed.ts",
    "eval": "tsx src/eval.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.88",
    "ai": "6.0.317",
    "nodejs-whisper": "0.4.1",
    "ollama-ai-provider-v2": "3.6.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
